{
  "__comment": "second-opinion monitoring dashboard. Import via Grafana → Dashboards → Import, then pick your Loki data source. Expects the reviewer's Loki events (set LOKI_URL / loki-url; see README 'Monitoring'). Works against Grafana Cloud Loki and self-hosted Loki alike.",
  "title": "second-opinion",
  "uid": "second-opinion",
  "tags": ["second-opinion", "code-review"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki data source",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "query": "label_values({service=\"second-opinion\"}, repo)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Reviews posted",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"second-opinion\", event=\"review\", outcome=\"posted\", repo=~\"$repo\"}[$__range]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Degraded / errored",
      "description": "Reviews that posted nothing (or errored). This is the reviewer-malfunction rate — the runtime counterpart of the fail-on-degraded tripwire.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"second-opinion\", event=\"review\", outcome=~\"degraded|error\", repo=~\"$repo\"}[$__range]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Review spend",
      "description": "Sum of per-review cost estimates (list-price based for agentic passes, so treat as ≈).",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(sum_over_time({service=\"second-opinion\", event=\"review\", repo=~\"$repo\"} | json | unwrap cost_usd | __error__=\"\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tokens",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(sum_over_time({service=\"second-opinion\", event=\"review\", repo=~\"$repo\"} | json | unwrap tokens | __error__=\"\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reviews by outcome",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (outcome) (count_over_time({service=\"second-opinion\", event=\"review\", repo=~\"$repo\"}[$__auto]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cost by repo (≈ USD)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (repo) (sum_over_time({service=\"second-opinion\", event=\"review\", repo=~\"$repo\"} | json | unwrap cost_usd | __error__=\"\" [$__auto]))",
          "legendFormat": "{{repo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Review duration",
      "description": "Wall-clock per review (all K passes + merge + post).",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "quantile_over_time(0.50, {service=\"second-opinion\", event=\"review\", repo=~\"$repo\"} | json | unwrap duration_s | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service=\"second-opinion\", event=\"review\", repo=~\"$repo\"} | json | unwrap duration_s | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens by repo",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (repo) (sum_over_time({service=\"second-opinion\", event=\"review\", repo=~\"$repo\"} | json | unwrap tokens | __error__=\"\" [$__auto]))",
          "legendFormat": "{{repo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Review rounds per PR",
      "description": "How many second-opinion reviews each PR has accumulated in the selected range (a force-push mints a new head SHA and earns a fresh round). Counts posted reviews only — skipped/degraded attempts are not rounds.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(25, sum by (repo, pr) (count_over_time({service=\"second-opinion\", event=\"review\", outcome=\"posted\", repo=~\"$repo\"} | json [$__range])))"
        }
      ],
      "transformations": [{ "id": "labelsToFields", "options": {} }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Sweeps (daemon liveness)",
      "description": "One event per sweep. A gap here means the daemon is down or wedged; outcome=skipped means the local llama-server was unreachable.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (outcome) (count_over_time({service=\"second-opinion\", event=\"sweep\", repo=~\"$repo\"}[$__auto]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent events (forensics)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{service=\"second-opinion\", repo=~\"$repo\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
