{
  "__comment": "second-opinion monitoring dashboard. Import via Grafana → Dashboards → Import, then pick your Loki data source. Expects the reviewer's Loki events (set LOKI_URL / loki-url; see README 'Monitoring'). Works against Grafana Cloud Loki and self-hosted Loki alike.",
  "title": "second-opinion",
  "uid": "second-opinion",
  "tags": ["second-opinion", "code-review"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki data source",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${datasource}" },
        "query": "label_values({service=\"second-opinion\"}, repo)",
        "refresh": 2,
        "allValue": ".*",
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Reviews posted",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"second-opinion\", event=\"review\", outcome=\"posted\", repo=~\"${repo:regex}\"}[$__range]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Degraded / errored",
      "description": "Reviews that posted nothing (or errored). This is the reviewer-malfunction rate — the runtime counterpart of the fail-on-degraded tripwire.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"second-opinion\", event=\"review\", outcome=~\"degraded|error\", repo=~\"${repo:regex}\"}[$__range]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Review spend",
      "description": "Sum of per-review cost estimates (list-price based for agentic passes, so treat as ≈).",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(sum_over_time({service=\"second-opinion\", event=\"review\", repo=~\"${repo:regex}\"} | json | unwrap cost_usd | __error__=\"\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tokens",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(sum_over_time({service=\"second-opinion\", event=\"review\", repo=~\"${repo:regex}\"} | json | unwrap tokens | __error__=\"\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reviews by outcome",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (outcome) (count_over_time({service=\"second-opinion\", event=\"review\", repo=~\"${repo:regex}\"}[$__auto]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cost by repo (≈ USD)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (repo) (sum_over_time({service=\"second-opinion\", event=\"review\", repo=~\"${repo:regex}\"} | json | unwrap cost_usd | __error__=\"\" [$__auto]))",
          "legendFormat": "{{repo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Review duration",
      "description": "Wall-clock per review (all K passes + merge + post).",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "quantile_over_time(0.50, {service=\"second-opinion\", event=\"review\", repo=~\"${repo:regex}\"} | json | unwrap duration_s | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service=\"second-opinion\", event=\"review\", repo=~\"${repo:regex}\"} | json | unwrap duration_s | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens by repo",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (repo) (sum_over_time({service=\"second-opinion\", event=\"review\", repo=~\"${repo:regex}\"} | json | unwrap tokens | __error__=\"\" [$__auto]))",
          "legendFormat": "{{repo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Review rounds per PR",
      "description": "How many second-opinion reviews each PR has accumulated in the selected range (a force-push mints a new head SHA and earns a fresh round). Counts posted reviews only — skipped/degraded attempts are not rounds.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(25, sum by (repo, pr) (count_over_time({service=\"second-opinion\", event=\"review\", outcome=\"posted\", repo=~\"${repo:regex}\"} | json [$__range])))"
        }
      ],
      "transformations": [{ "id": "labelsToFields", "options": {} }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Sweeps (daemon liveness)",
      "description": "One event per daemon sweep (delivery=daemon only — Action runs also emit sweep events, and unscoped they would paper over a real gap in the daemon's cadence). A gap here means the daemon is down or wedged. Outcomes: ok = healthy sweep; silent_failure = sweep ran but ≥1 review degraded/errored with nothing posted; skipped = local llama-server unreachable; error = sweeps running but throwing before completing.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (outcome) (count_over_time({service=\"second-opinion\", event=\"sweep\", delivery=\"daemon\", repo=~\"${repo:regex}\"}[$__auto]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Degraded passes — what they burned",
      "description": "Every pass that did NOT end 'ok', ranked by tokens spent before it stopped. The review event pools spend across all K passes, so it cannot distinguish a pass that died instantly from one that burned millions first (the runaway signature: 12.6M tokens, $1.96, zero output). A large number here with status=timeout is the case for max-pass-tokens; a small one means the pass failed early and a spend ceiling would not have helped.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(25, sum by (repo, pr, pass, status) (max_over_time({service=\"second-opinion\", event=\"pass\", outcome!=\"ok\", repo=~\"${repo:regex}\"} | json | unwrap tokens | __error__=\"\" [$__range])))"
        }
      ],
      "transformations": [{ "id": "labelsToFields", "options": {} }],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Pass duration",
      "description": "Wall-clock per agentic pass. Read against 'Review duration': that panel also includes diff fetch, worktree setup, merge and post, so the gap between the two is harness overhead rather than model time. Watch for a rising curve — a pass timeout is usually the end of a latency creep, not a sudden hang.",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "quantile_over_time(0.50, {service=\"second-opinion\", event=\"pass\", repo=~\"${repo:regex}\"} | json | unwrap elapsed_s | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service=\"second-opinion\", event=\"pass\", repo=~\"${repo:regex}\"} | json | unwrap elapsed_s | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Union merge health (K>1)",
      "description": "The K>1 editorial merge. merged = first attempt worked; merged_on_retry = attempt 1 failed and the retry saved it; fallback = both failed and the raw passes were posted unmerged. Only 'fallback' annotates in CI, so merged_on_retry appearing at all is the early warning — it is the same failure, one attempt short of costing you the union. A sustained run of either is usually the provider, not chance: a 402 followed by an empty 200 is credits exhaustion, which recurs every sweep until fixed (check the 'failures' field in the forensics panel).",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (outcome) (count_over_time({service=\"second-opinion\", event=\"merge\", repo=~\"${repo:regex}\"}[$__auto]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent events (forensics)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{service=\"second-opinion\", repo=~\"${repo:regex}\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
